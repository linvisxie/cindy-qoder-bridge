// 抓 ## <version> 到下一个 ## 之间的正文。
//
// 不用「把版本号拼进正则」：版本号来自命令行与文件，拼进正则就要调用方正确转义，
// 漏一个就是 ReDoS / 误匹配入口（CodeQL 会报 high）。改成按行定位 + 精确比较。
const lines = changelog.split(/\r?\n/);
const headingIndex = lines.findIndex((line) => line.trim() === '## ' + version);
if (headingIndex < 0) {
  console.error('::error::CHANGELOG.md 里找不到 ## ' + version + ' 小节');
  process.exit(1);
}
let endIndex = lines.length;
for (let i = headingIndex + 1; i < lines.length; i++) {
  if (lines[i].startsWith('## ')) { endIndex = i; break; }
}
let body = lines.slice(headingIndex + 1, endIndex).join('\n').trim().replace(/\n?-{3,}\s*$/, '').trim();